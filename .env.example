# Database — SQLite for local development. For production use PostgreSQL
# (change `provider` in prisma/schema.prisma to "postgresql" and set this URL).
DATABASE_URL="file:./ore.db"

# Public base URL used for personalized invitation links and social previews.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Secret used to hash visitor IPs for rate limiting (never exposed to the client).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET="change-me-to-a-long-random-string"
